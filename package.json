{
  "name": "@soroban-state-manager/core",
  "version": "0.1.0",
  "description": "Programmatic TTL management and ledger entry expiration toolkit for Soroban smart contracts",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.esm.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "require": "./dist/react.js",
      "import": "./dist/react.esm.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "docs": "typedoc --out docs src/index.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "soroban",
    "stellar",
    "blockchain",
    "smart-contracts",
    "ttl",
    "state-expiration",
    "ledger",
    "sdk",
    "typescript"
  ],
  "author": "soroban-state-manager contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Soroban-geeks/soroban-state-manager.git"
  },
  "bugs": {
    "url": "https://github.com/Soroban-geeks/soroban-state-manager/issues"
  },
  "homepage": "https://github.com/Soroban-geeks/soroban-state-manager#readme",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^12.0.0",
    "eventemitter3": "^5.0.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "react": "^18.0.0",
    "ts-jest": "^29.0.0",
    "tsup": "^8.0.0",
    "typedoc": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
